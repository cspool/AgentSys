@@ -1498,6 +1498,25 @@ inline __device__ void compute_fused_tb_attn(const Params &prefill_params, const
     // Fetch from shared memory the assigned blockId and operation.
     linear_block_id = ((int*)smem_)[0];
     op = ((int*)smem_)[1];
+#if defined(POD_TBLOG)
+    // h23 调试: 记录每个 CTA 的 (smid, op, t_start, t_end), 用于测量 P/D 的**瞬时**共驻组成。
+    // 日志区挂在 tbAssign 尾部: [numSMs+2]=计数器, 其后每 4 个 int 一条。
+    // 提前 return 的空转 CTA 自然留 t_end=0, 分析时排除。
+    if(threadIdx.x == 0) {
+        int nsm_dbg; asm volatile("mov.u32 %0, %%nsmid;" : "=r"(nsm_dbg));
+        int smid_dbg; asm volatile("mov.u32 %0, %%smid;" : "=r"(smid_dbg));
+        unsigned long long tnow; asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(tnow) :: "memory");
+        int slot = atomicAdd(&tbAssign[nsm_dbg + 2], 1);
+        if(slot < POD_TBLOG) {
+            int *e = &tbAssign[nsm_dbg + 3 + 4*slot];
+            e[0] = smid_dbg; e[1] = op;
+            e[2] = (int)(tnow & 0x7FFFFFFFull); e[3] = 0;
+        }
+        ((int*)smem_)[2] = slot;
+    }
+    __syncthreads();
+    const int pod_log_slot = ((int*)smem_)[2];
+#endif
     // Sync to force all threads to wait
     __syncthreads();
 
@@ -1587,6 +1606,16 @@ inline __device__ void compute_fused_tb_attn(const Params &prefill_params, const
             }
         }*/
     }
+#if defined(POD_TBLOG)
+    // 必须等全 CTA 的 epilogue(写 O / softmax_lse) 完成, 否则 thread 0 提前读表会系统性低估时长,
+    // 且 P 与 D 的 epilogue 长度不同 => 低估幅度不对称, 直接污染时间加权 P:D。
+    __syncthreads();
+    if(threadIdx.x == 0 && pod_log_slot >= 0 && pod_log_slot < POD_TBLOG) {
+        int nsm_dbg; asm volatile("mov.u32 %0, %%nsmid;" : "=r"(nsm_dbg));
+        unsigned long long tend; asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(tend) :: "memory");
+        tbAssign[nsm_dbg + 3 + 4*pod_log_slot + 3] = (int)(tend & 0x7FFFFFFFull);
+    }
+#endif
