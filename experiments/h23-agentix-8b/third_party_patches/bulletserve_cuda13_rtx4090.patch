diff --git a/csrc/src/libsmctrl.c b/csrc/src/libsmctrl.c
index 56e962f..d1f1539 100644
--- a/csrc/src/libsmctrl.c
+++ b/csrc/src/libsmctrl.c
@@ -200,6 +200,10 @@ void libsmctrl_set_next_mask(uint64_t mask) {
 // 12.5 tested on 555.58.02
 // 12.6 tested on 560.35.03
 #define CU_12_7_MASK_OFF 0x4fc
+// h23 (2026-09-22): CUDA 13.2 / driver 595.91.07 实测偏移
+// 方法: MASK_OFF 环境变量暴扫 delta in [-256,512] step 4, 每次独立进程
+// 上游 libsmctrl 与 Bullet 的版本表都止于 12.8, 13.x 会 abort
+#define CU_13_2_MASK_OFF 0x604
 // CUDA 12.7 and 12.8 use the same offset
 // 12.7 tested on 565.77
 // 12.8 tested on 570.124.06
@@ -337,6 +341,13 @@ void libsmctrl_set_stream_mask_ext(void* stream, uint128_t mask) {
 	case 12080:
 		hw_mask_v2 = (void*)(stream_struct_base + CU_12_7_MASK_OFF);
 		break;
+	// h23: CUDA 13.x (驱动 595+) —— 实测 13.2 为 0x604
+	case 13000:
+	case 13010:
+	case 13020:
+	case 13030:
+		hw_mask_v2 = (void*)(stream_struct_base + CU_13_2_MASK_OFF);
+		break;
 #elif __aarch64__
 	case 9000: {
 		// Jetson TX2 offset is slightly different on CUDA 9.0.
