@main () -> () {
    graph.SubGraphOp @agentsys_transformer <CPU> {
        (%0:tensor<[1, 32, 2048], UInt16PerTensor, CPU>) -> (%8:tensor<[1, 16, 32, 32], UInt16PerTensor, CPU>) {
            linalg.CPU.LinearOp <name="q_proj"> (%0:tensor<[1, 32, 2048], UInt16PerTensor, CPU>) -> (%1:tensor<[1, 32, 2048], UInt16PerTensor, CPU>)
            linalg.CPU.LinearOp <name="k_proj"> (%0:tensor<[1, 32, 2048], UInt16PerTensor, CPU>) -> (%2:tensor<[1, 32, 1024], UInt16PerTensor, CPU>)
            linalg.CPU.CastTypeOp <name="q_cast"> (%1:tensor<[1, 32, 2048], UInt16PerTensor, CPU>) -> (%3:tensor<[1, 32, 2048], Float16, CPU>)
            linalg.CPU.RMSNormOp <name="k_norm"> (%2:tensor<[1, 32, 1024], UInt16PerTensor, CPU>) -> (%4:tensor<[1, 32, 1024], UInt16PerTensor, CPU>)
            linalg.CPU.AddOp <name="qk_add"> (%3:tensor<[1, 32, 2048], Float16, CPU>, %4:tensor<[1, 32, 1024], UInt16PerTensor, CPU>) -> (%5:tensor<[1, 32, 2048], UInt16PerTensor, CPU>)
            linalg.CPU.TransposeOp <name="k_transpose"> (%4:tensor<[1, 32, 1024], UInt16PerTensor, CPU>) -> (%6:tensor<[1, 16, 64, 32], UInt16PerTensor, CPU>)
            linalg.CPU.MatMulOp <name="qk"> (%5:tensor<[1, 32, 2048], UInt16PerTensor, CPU>, %6:tensor<[1, 16, 64, 32], UInt16PerTensor, CPU>) -> (%7:tensor<[1, 16, 32, 32], UInt16PerTensor, CPU>)
            linalg.CPU.SoftmaxOp <name="softmax"> (%7:tensor<[1, 16, 32, 32], UInt16PerTensor, CPU>) -> (%8:tensor<[1, 16, 32, 32], UInt16PerTensor, CPU>)
        }
    }
}

